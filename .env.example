# Copia este fichero a .env.local y rellena los valores.

# --- Panel del CRM (/admin) ---
# Contrasena de acceso al panel de administracion de leads.
# Sin ella, el panel queda deshabilitado (nadie puede entrar).
ADMIN_PASSWORD=

# (Opcional) Ruta del fichero SQLite del CRM.
# Por defecto: ./data/crm.db
# CRM_DATABASE_PATH=/ruta/persistente/crm.db

# --- Reenvio opcional de leads a un CRM externo ---
# Ademas de guardarse en el panel, cada lead puede reenviarse a este webhook
# (CRM externo, Make/Zapier, endpoint propio). Dejar vacio para desactivarlo.
LEADS_WEBHOOK_URL=
